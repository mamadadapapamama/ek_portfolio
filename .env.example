# Notion integration for /writing
# Copy to .env locally, then add the same keys in Vercel → Settings → Environment Variables

NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override Notion property names (defaults shown)
# NOTION_PROP_TITLE=Title
# NOTION_PROP_SLUG=Slug
# NOTION_PROP_DATE=Date
# NOTION_PROP_PUBLISHED=Published
# NOTION_PROP_SUMMARY=Summary
# NOTION_PROP_COVER=Cover
